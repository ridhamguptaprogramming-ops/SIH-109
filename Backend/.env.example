# Copy to .env (never commit .env). Server-side only: this file is read by FastAPI.

# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=https://ypvgmfsjkqudqaivdjsy.supabase.co
# anon / publishable key (safe for browsers; backend uses it for the optional login proxy)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlwdmdtZnNqa3F1ZHFhaXZkanN5Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTEyMTEyODUsImV4cCI6MjEwNjc4NzI4NX0.hVyDARXvJpCJy-jpFBY1bV-bWlRN0b9M-dFeNBMfYMU
# service-role / secret key: BACKEND ONLY. Never give to React, ESP32, Wokwi or GitHub.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string from Supabase Dashboard > Connect (use the Session pooler, port 5432)
# e.g. postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.ypvgmfsjkqudqaivdjsy.supabase.co:5432/postgres

# Used to hash device API keys (HMAC pepper). Generate: openssl rand -hex 32
SECRET_KEY=
# Comma-separated allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Only for legacy Supabase projects that still sign JWTs with a shared HS256 secret (optional)
SUPABASE_JWT_SECRET=
