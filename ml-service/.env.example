SERVICE_NAME=mastitis-ml-service
ML_SERVICE_HOST=0.0.0.0
ML_SERVICE_PORT=8000

MODEL_PATH=models/mastitis_model.joblib
PREPROCESSOR_PATH=models/preprocessor.joblib
METADATA_PATH=models/model_metadata.json
MOCK_DATA_PATH=data/mock_sensor_data.json

# Risk classification thresholds (configurable probability ranges)
RISK_THRESHOLD_LOW=0.25
RISK_THRESHOLD_MODERATE=0.50
RISK_THRESHOLD_HIGH=0.75

MODEL_VERSION=1.0.0-demo
PREDICTION_WINDOW=7-14 days
